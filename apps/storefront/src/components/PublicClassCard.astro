---
import { GraduationCap } from '@lucide/astro';
import { formatClassSchedule } from '../lib/format-class-schedule';
import { getPublicCardVisual } from '../lib/item-styles';

export type PublicClassCardData = {
  id: string;
  task_id: string;
  scheduled_at: string;
  offering: {
    name: string;
    description: string | null;
    duration_min: number;
    location: string | null;
  };
};

interface Props {
  instance: PublicClassCardData;
}

const { instance } = Astro.props;
const { offering } = instance;

const v = getPublicCardVisual('class');
const when = formatClassSchedule(instance.scheduled_at);
const duration =
  Number.isFinite(offering.duration_min) && offering.duration_min > 0
    ? `${offering.duration_min} min`
    : null;
const location = offering.location?.trim() || null;

const blocks: { label: string; value: string; isLink?: boolean }[] = [
  { label: 'When', value: when },
];
if (duration) blocks.push({ label: 'Duration', value: duration });
if (location) {
  const isUrl = /^https?:\/\//i.test(location);
  blocks.push({ label: 'Location', value: location, isLink: isUrl });
}
---

<div
  class:list={[
    'break-inside-avoid mb-6 rounded-2xl border-2 p-5 shadow-sm',
    v.bg,
    v.border,
  ]}
>
  <div class="mb-3 flex flex-wrap items-center gap-2">
    <span
      class:list={['inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold', v.chip]}
    >
      <GraduationCap class="size-3.5 shrink-0 opacity-90" aria-hidden="true" />
      {v.label}
    </span>
    <span class="text-xs text-zinc-500">Scheduled · {when}</span>
  </div>

  <h3 class="text-lg font-semibold leading-snug tracking-tight text-zinc-900">{offering.name}</h3>

  {
    offering.description?.trim() ? (
      <p class="mt-2 text-sm leading-relaxed text-zinc-700">{offering.description}</p>
    ) : null
  }

  {
    blocks.length > 0 ? (
      <dl class="mt-4 space-y-2 border-t border-zinc-200/80 pt-4 text-sm text-zinc-700">
        {blocks.map((row) => (
          <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-2">
            <dt class="shrink-0 font-medium text-zinc-500">{row.label}</dt>
            <dd class="min-w-0 break-words">
              {row.isLink ? (
                <a
                  href={row.value}
                  class="font-medium text-indigo-600 underline decoration-indigo-300 underline-offset-2 hover:text-indigo-700"
                >
                  {row.value}
                </a>
              ) : (
                row.value
              )}
            </dd>
          </div>
        ))}
      </dl>
    ) : null
  }
</div>
