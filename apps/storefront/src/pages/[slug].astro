---
import '../styles/global.css';
import PublicFeed from '../components/PublicFeed';
import PublicVideoSection from '../components/PublicVideoSection';
import StorefrontHero from '../components/hero/StorefrontHero.jsx';
import { resolveCrmOriginForStorefront } from '../lib/crm-origin';
import { getPublicEnv } from '../lib/public-env';
import type { PublicFeedItem, PublicClassCardData, TaskCardShape } from '../lib/public-feed-types';
import { sortPublicFeedItems } from '../lib/public-feed-types';
import { mapPublicVideoPublications } from '../lib/public-video-types';
import { normalizeClassInstanceRow } from '../lib/supabase-embed';
import { createStorefrontClient } from '../lib/supabase';

const supabaseUrl = getPublicEnv('PUBLIC_SUPABASE_URL');
const supabaseAnonKey = getPublicEnv('PUBLIC_SUPABASE_ANON_KEY');

type PublicBranding = {
  hero_url?: string;
  description?: string;
  primary_color?: string;
  logo_url?: string;
};

function parseBranding(raw: unknown): PublicBranding {
  if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return {};
  const o = raw as Record<string, unknown>;
  const str = (k: string) => (typeof o[k] === 'string' ? (o[k] as string) : undefined);
  return {
    hero_url: str('hero_url'),
    description: str('description'),
    primary_color: str('primary_color'),
    logo_url: str('logo_url'),
  };
}

const slug = Astro.params.slug?.trim();
if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const supabase = createStorefrontClient();

const { data: workspace, error: wsErr } = await supabase
  .from('workspaces')
  .select('*')
  .eq('public_slug', slug)
  .eq('is_public', true)
  .maybeSingle();

if (wsErr || !workspace) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const ws = workspace as {
  id: string;
  name: string;
  is_public?: boolean | null;
  public_branding: unknown;
  category_type?: string | null;
};

/** Defense-in-depth: never list public videos unless the workspace is still public. */
if (ws.is_public !== true) {
  return new Response(null, { status: 404, statusText: 'Not found' });
}

const previewEligible =
  ws.category_type === 'business' || ws.category_type === 'fitness';

const branding = parseBranding(ws.public_branding);
const accent = branding.primary_color?.trim() || '#2563eb';

const { data: workspaceBubbles } = await supabase
  .from('bubbles')
  .select('id')
  .eq('workspace_id', ws.id);

const bubbleIds = workspaceBubbles?.map((b) => (b as { id: string }).id) ?? [];

/** Public cards for this workspace via tasks → bubbles (inner) → workspace */
const { data: tasksJoined, error: tasksErr } = await supabase
  .from('tasks')
  .select(
    `
    id,
    bubble_id,
    title,
    description,
    item_type,
    metadata,
    scheduled_on,
    created_at,
    bubbles!inner (
      workspace_id
    )
  `,
  )
  .eq('visibility', 'public')
  .neq('item_type', 'class')
  .eq('bubbles.workspace_id', ws.id)
  .order('created_at', { ascending: false });

type TaskJoinedRow = TaskCardShape & { bubble_id: string };

let publicTaskRows: TaskJoinedRow[] = (tasksJoined as TaskJoinedRow[] | null) ?? [];

if (tasksErr) {
  if (bubbleIds.length === 0) {
    publicTaskRows = [];
  } else {
    const { data: fallbackTasks } = await supabase
      .from('tasks')
      .select(
        'id, bubble_id, title, description, item_type, metadata, scheduled_on, created_at',
      )
      .eq('visibility', 'public')
      .neq('item_type', 'class')
      .in('bubble_id', bubbleIds)
      .order('created_at', { ascending: false });
    publicTaskRows = (fallbackTasks as TaskJoinedRow[]) ?? [];
  }
}

const nowIso = new Date().toISOString();

const { data: publicClassRows, error: classesErr } = await supabase
  .from('class_instances')
  .select(
    `
    id,
    task_id,
    scheduled_at,
    status,
    offering:class_offerings (
      name,
      description,
      duration_min,
      location
    ),
    tasks (
      bubble_id
    )
  `,
  )
  .eq('workspace_id', ws.id)
  .eq('visibility', 'public')
  .eq('status', 'available')
  .gte('scheduled_at', nowIso)
  .order('scheduled_at', { ascending: true });

const normalizedClassRows = (publicClassRows ?? [])
  .map((row) => normalizeClassInstanceRow(row))
  .filter((row): row is NonNullable<ReturnType<typeof normalizeClassInstanceRow>> => row != null);

const publicFeed: PublicFeedItem[] = sortPublicFeedItems([
  ...publicTaskRows.map((row): PublicFeedItem => {
    const card: TaskCardShape = {
      id: row.id,
      title: row.title,
      description: row.description,
      item_type: row.item_type,
      metadata: row.metadata,
      scheduled_on: row.scheduled_on,
      created_at: row.created_at,
    };
    return {
      kind: 'task',
      taskId: row.id,
      bubbleId: row.bubble_id,
      sortAt: row.scheduled_on?.trim() || row.created_at,
      card,
    };
  }),
  ...(!classesErr && normalizedClassRows.length
    ? normalizedClassRows
        .filter((row) => row.offering?.name && row.task_id && row.tasks?.bubble_id)
        .map((row): PublicFeedItem => {
          const instance: PublicClassCardData = {
            id: row.id,
            task_id: row.task_id,
            scheduled_at: row.scheduled_at,
            offering: {
              name: row.offering!.name,
              description: row.offering!.description,
              duration_min: row.offering!.duration_min,
              location: row.offering!.location,
            },
          };
          return {
            kind: 'class',
            taskId: row.task_id,
            bubbleId: row.tasks!.bubble_id,
            sortAt: row.scheduled_at,
            instance,
          };
        })
    : []),
]);

const { data: videoPubRows } = await supabase
  .from('video_library_publications')
  .select(
    `
    id,
    title,
    published_at,
    class_instance_id,
    class_instances (
      metadata,
      class_offerings ( name )
    )
  `,
  )
  .eq('workspace_id', ws.id)
  .eq('access_scope', 'public_storefront')
  .is('unpublished_at', null)
  .order('published_at', { ascending: false });

const publicVideos = mapPublicVideoPublications((videoPubRows ?? []) as unknown[]);

const crmLoginBase = `${resolveCrmOriginForStorefront(getPublicEnv('PUBLIC_APP_ORIGIN'), Astro.url.hostname)}/login`;
const joinHref = `${crmLoginBase}?next=${encodeURIComponent(`/app/${ws.id}`)}`;
/** Same post-login `next` as Join community; Log in is secondary CTA styling only. */
const loginHref = joinHref;

const pageTitle = `${ws.name} · BuddyBubble`;
const heroImage = branding.hero_url?.trim() ?? '';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-zinc-100 text-zinc-900 antialiased">
    <header class="relative overflow-hidden border-b border-black/10">
      {
        heroImage ? (
          <div
            class="absolute inset-0 bg-cover bg-center"
            style={`background-image: url(${JSON.stringify(heroImage)})`}
          />
        ) : null
      }
      <div
        class:list={[
          'absolute inset-0',
          heroImage ? 'bg-gradient-to-b from-black/60 via-black/45 to-black/70' : 'bg-zinc-900',
        ]}
      />
      <div class="relative">
        {
          previewEligible ? (
            <StorefrontHero
              client:load
              publicSlug={slug}
              categoryType={(ws.category_type ?? 'business') as 'business' | 'fitness'}
              workspaceName={ws.name}
              workspaceId={ws.id}
              accentColor={accent}
              joinHref={joinHref}
              loginHref={loginHref}
            />
          ) : (
            <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-6 px-4 py-8 sm:px-6 lg:py-10">
              <div class="flex min-w-0 items-center gap-4">
                {branding.logo_url ? (
                  <img
                    src={branding.logo_url}
                    alt=""
                    class="h-12 w-12 shrink-0 rounded-xl border border-white/20 bg-white/10 object-cover shadow-md"
                    loading="lazy"
                  />
                ) : null}
                <div class="min-w-0">
                  <p class="text-xs font-medium uppercase tracking-wider text-white/70">BuddyBubble community</p>
                  <h1 class="truncate text-2xl font-bold tracking-tight text-white drop-shadow sm:text-3xl">
                    {ws.name}
                  </h1>
                </div>
              </div>
              <div class="flex shrink-0 items-center gap-4">
                <a
                  href={loginHref}
                  class="text-sm font-medium text-white/80 underline decoration-white/30 underline-offset-4 transition hover:text-white hover:decoration-white/60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                >
                  Log in
                </a>
                <a
                  href={joinHref}
                  class="inline-flex items-center justify-center rounded-xl px-6 py-3 text-base font-semibold text-white shadow-lg ring-2 ring-white/25 transition hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
                  style={`background-color: ${accent}`}
                >
                  Join community
                </a>
              </div>
            </div>
          )
        }
      </div>
    </header>

    <section class="border-b border-zinc-200 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
        <p class="max-w-3xl text-lg leading-relaxed text-zinc-800">
          {
            branding.description?.trim()
              ? branding.description
              : `Welcome to ${ws.name}. Browse public cards below.`
          }
        </p>
      </div>
    </section>

    {
      publicVideos.length > 0 ? (
        <section class="border-b border-zinc-200 bg-zinc-50">
          <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
            <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
              <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500">Videos</h2>
            </div>
            <PublicVideoSection client:load videos={publicVideos} />
          </div>
        </section>
      ) : null
    }

    <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-500">Public cards</h2>
      </div>
      <PublicFeed
        client:load
        workspaceId={ws.id}
        initialFeed={publicFeed}
        bubbleIds={bubbleIds}
        supabaseUrl={supabaseUrl}
        supabaseAnonKey={supabaseAnonKey}
      />
    </main>
  </body>
</html>
